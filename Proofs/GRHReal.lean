/-
Helper lemma: The norm of the Riemann Zeta function tends to infinity as s approaches 1.
-/
theorem norm_riemannZeta_tendsto_atTop_one : Filter.Tendsto (fun s : ℂ => ‖riemannZeta s‖) (nhdsWithin 1 {1}ᶜ) Filter.atTop := by

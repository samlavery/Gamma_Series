    (h_no_real_zeros : ∀ {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) (σ : ℝ),
      0 < σ → σ < 1 → DirichletCharacter.LFunction χ (σ : ℂ) ≠ 0) : RiemannHypothesis :=
  grh_implies_rh (grh_from_bridges h_bridge h_no_real_zeros)



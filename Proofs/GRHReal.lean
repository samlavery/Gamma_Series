  exact absurd h_contradiction ( by erw [ riemannZeta_zero ] ; norm_num )

/-
Definition of s_seq and lemma for its real part recurrence.
-/
noncomputable def s_seq (s : ℂ) : ℕ → ℂ
| 0 => s
| n+1 => 2 * (s_seq s n).re * (s_seq s n)

theorem s_seq_re (s : ℂ) (n : ℕ) : (s_seq s (n + 1)).re = 2 * (s_seq s n).re ^ 2 := by
  simp [s_seq, Complex.mul_re]
  ring

/-
Closed form for the real part of s_seq: Re(s_n) = (1/2) * (2 * Re(s))^(2^n).
-/
theorem s_seq_re_closed_form (s : ℂ) (n : ℕ) : (s_seq s n).re = (1/2) * (2 * s.re) ^ (2^n) := by
  induction' n with n ih;
  · norm_num [ s_seq ] ; ring;
  · rw [ pow_succ, pow_mul' ] ; rw [ s_seq_re ] ; rw [ ih ] ; ring;
    norm_num [ pow_mul' ]

